---
import { COPY } from '../i18n';
import '../styles/theme.css';

const copy = COPY.en;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>404 · {copy.hero.title}</title>
	</head>
	<body class="flex min-h-dvh flex-col items-center justify-center gap-4 font-body">
		<h1 class="font-title text-4xl font-bold">404</h1>
		<a
			href={import.meta.env.BASE_URL}
			class="min-h-11 rounded border-2 border-crit px-6 py-2.5 font-bold text-crit"
		>
			{copy.hero.title}
		</a>
	</body>
</html>
