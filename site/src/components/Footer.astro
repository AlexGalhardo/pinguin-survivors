---
import { type Copy, type Locale, localePath } from '../i18n';
import pkg from '../../package.json';

interface Props {
	locale: Locale;
	copy: Copy;
}

const { locale, copy } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<footer
	class="flex min-h-12 flex-wrap items-center justify-center gap-x-4 gap-y-1 px-[4vw] py-2 text-xs text-text-dim"
>
	<span>{copy.footer.legal}</span>
	<span>{copy.footer.privacy}</span>
	<a
		href={`${base}${localePath(locale)}press/`}
		class="underline hover:text-text-light focus-visible:outline-2 focus-visible:outline-crit"
	>
		{copy.footer.press}
	</a>
	<span>{copy.footer.made}</span>
	<span>{copy.footer.version.replace('{v}', pkg.version)}</span>
</footer>
