---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Copy } from '../i18n';

interface Props {
	copy: Copy;
	poster: ImageMetadata;
}

const { copy, poster } = Astro.props;
const img = await getImage({ src: poster, width: 688, height: 384, format: 'webp' });
---

<div class="relative aspect-video w-full overflow-hidden rounded border border-snow-dark bg-night">
	<!-- No source until the trailer exists (1.0); the poster is the key art. -->
	<video
		controls
		preload="none"
		poster={img.src}
		aria-label={copy.trailer.posterAlt}
		class="size-full object-cover"
	>
	</video>
	<p
		class="pointer-events-none absolute inset-x-0 bottom-0 bg-night/80 px-3 py-2 text-center text-sm text-text-dim"
	>
		{copy.trailer.placeholder}
	</p>
</div>
