{
	"name": "pinguin-survivors",
	"private": true,
	"version": "0.0.12",
	"buildName": "playdev-7",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "bun check && bunx --bun vite build",
		"build:demo": "bun scripts/build-demo.ts",
		"build:desktop": "bun scripts/build-desktop.ts",
		"build:desktop:demo": "bun scripts/build-desktop.ts --demo",
		"preview": "bunx --bun vite preview",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"e2e": "bun scripts/e2e.ts",
		"typecheck": "bun check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:i18n": "bun scripts/lint-i18n.ts",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#site/dist\" \"#.agents/skills\" \"#TODO.md\" \"#PLAN.md\"",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"release": "bun scripts/release.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource/noto-sans-sc": "5.3.1",
		"@fontsource/pixelify-sans": "5.3.0",
		"@fontsource/rubik": "5.3.0",
		"phaser": "4.2.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"happy-dom": "21.0.4",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.24.0",
		"playwright": "1.65.0",
		"sharp": "0.35.5",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	}
}
